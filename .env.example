# The variables of compose.yaml. Copy this file to .env and fill it in.
# apps/web/DEPLOY.md, section 4, explains each variable of the web service.
# Make each secret with `openssl rand -hex 32`, and KENTO_SECRETS_KEY with `openssl rand -base64 32`.
# Never commit .env: it holds secrets.

# The database.
POSTGRES_PASSWORD=

# The GitHub App (apps/web/DEPLOY.md, section 3).
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# The PEM on one line: write each new line as \n.
GITHUB_APP_PRIVATE_KEY=
# The login of the bot of your App: <slug of your App>[bot]. Kentō finds its own reviews by it.
KENTO_BOT_LOGIN=kento-review[bot]

# The sign-in of the screens. KENTO_PUBLIC_URL is the HTTPS origin of the reverse proxy.
KENTO_PUBLIC_URL=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
KENTO_SESSION_SECRET=
# The proxies in front of the service whose X-Forwarded-For names the client: 1 behind Traefik (or
# Caddy, nginx) alone, 2 behind a CDN then Traefik, 0 when nothing is in front. Required when
# KENTO_PUBLIC_URL is https: the sign-in limits are by client.
KENTO_TRUSTED_PROXY_HOPS=1

# The master key of the keys of the providers that the Settings screen stores.
KENTO_SECRETS_KEY=

# The GitHub logins that this service reviews, comma-separated. Empty: every installation.
KENTO_ALLOWED_ORGS=

# The names of this instance (apps/web/DEPLOY.md, section 4, "The names of the instance").
# The names after @ that start a command, comma-separated: the first one is the name that the bot
# shows, the others are aliases. Usually the slug of your App. Empty: kento-review,sakuga-review.
KENTO_COMMAND_NAMES=
# The name of the check of a review, as a required check of a branch rule names it. Empty: Sakuga Review.
KENTO_CHECK_NAME=
# The image of the runner, without a tag, in the docker run of the Runners screen.
# Empty: ghcr.io/sakuga-software/kento-runner.
KENTO_RUNNER_IMAGE=
# The bots that a new org trusts, comma-separated (renovate reads as renovate[bot]). Empty: no bot.
# Without this line, a new org trusts sakuga-agent[bot].
KENTO_DEFAULT_TRUSTED_BOTS=

# The runner of compose.yaml registers with this token (32 characters or more).
KENTO_RUNNER_REGISTRATION_TOKEN=
KENTO_RUNNER_NAME=compose

# The model provider of the runner. It calls the model with its own key.
# PROVIDER_KIND: openrouter, anthropic, openai_compatible or ollama (apps/runner/README.md).
# PROVIDER_BASE_URL: empty for anthropic; required for openai_compatible. PROVIDER_API_KEY: none for ollama.
PROVIDER_KIND=openrouter
PROVIDER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_API_KEY=
