{
  "name": "@kento-review/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Kentō web service: GitHub webhooks, runner API and settings, on review.sakuga.dev.",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint --deny-warnings app test e2e scripts server.ts drizzle.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test remix test 'app/**/*.test.ts'",
    "test:db": "NODE_ENV=test remix test 'test/db/**/*.test.ts' --concurrency 1",
    "e2e": "playwright test",
    "design:board": "node --import remix/node-tsx scripts/design-board.tsx",
    "measures": "node --import remix/node-tsx scripts/measures.ts",
    "bench:cases": "node --import remix/node-tsx scripts/bench-cases.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@kento-review/engine": "workspace:*",
    "@kento-review/protocol": "workspace:*",
    "better-auth": "1.7.26",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1",
    "remix": "3.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  }
}
